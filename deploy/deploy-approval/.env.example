# Deploy Approval Agent — minimal user configuration (final alignment).
#
# No approval authority config needed: machine owners are defined in
# MACHINE_OWNERS_FILE (YAML). Each machine has its own owners[].
#
# COS credentials for evidence uploads (optional; required for case mode).
# COS_REGION=ap-guangzhou
# COS_BUCKET=my-bucket
# COS_SECRET_ID=xxx
# COS_SECRET_KEY=xxx
# COS_SESSION_TOKEN=xxx
# COS_PREFIX=deploy-artifacts
# COS_SIGNED_URL_TTL_SECONDS=86400

# Machine owners file (YAML)
MACHINE_OWNERS_FILE=/run/deploy-approval/machines.yaml

# Default repos (when unset): 4paradigm/phanthymotus,4paradigm/phanthymotus-driver
# GITHUB_REPOS=4paradigm/phanthymotus,4paradigm/phanthymotus-driver
